{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mythos",
  "version": "0.1.0",
  "identifier": "app.indyshares.mythos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mythos",
        "width": 1366,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Mythos knowledge & writing workspace",
    "longDescription": "Cloud-based knowledge management and writing workspace with a hierarchical file system, Markdown editor, internal links, graph view, story timeline, and AI assistant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
